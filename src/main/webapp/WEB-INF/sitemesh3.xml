<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!-- 1. Loại trừ các tài nguyên tĩnh và trang nhúng -->
    <mapping path="/decorators/*" exclude="true" />
    <mapping path="/WEB-INF/decorators/*" exclude="true" />
    <mapping path="/common/*" exclude="true" />
    <mapping path="/image*" exclude="true" />
    <mapping path="/static/*" exclude="true" />
    <mapping path="/template/*" exclude="true" />
    <mapping path="/assets/*" exclude="true" />

    <!-- 2. SiteMesh 3 tự động tìm trong /WEB-INF/decorators/ -->
    <mapping path="/admin/*" decorator="/admin.jsp" />
    <mapping path="/*" decorator="/web.jsp" />
</sitemesh>
